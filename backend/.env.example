# Database (SQLite default; Postgres-ready)
# DATABASE_URL=sqlite:///./pathology_explainer.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/pathology

# LLM
LLM_PROVIDER=mock
LLM_MODEL=mock-heuristic-v1
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1

# CORS / app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true
RATE_LIMIT_EXPLAIN=30/minute
SESSION_TTL_HOURS=72
