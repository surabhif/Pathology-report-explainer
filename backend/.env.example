# Database (SQLite default; Postgres-ready — needs psycopg[binary])
# DATABASE_URL=sqlite:///./pathology_explainer.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/pathology

# APP_ENV=development
# APP_ENV=production

# LLM — mock is the default when no key is set
LLM_PROVIDER=mock
LLM_MODEL=mock-heuristic-v1
LLM_TIMEOUT_SECONDS=120

# xAI Grok (preferred hosted provider for this project)
# LLM_PROVIDER=xai
# LLM_MODEL=grok-4.20-0309-non-reasoning
# LLM_API_KEY=xai-...
# LLM_BASE_URL=https://api.x.ai/v1
# XAI_API_KEY=xai-...

# OpenAI / compatible
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1

# Demo tokens (required in production to seed demo users; never use known defaults there)
# DEMO_ADMIN_TOKEN=
# DEMO_ANNOTATOR_TOKEN=
# DEMO_CLINICIAN_TOKEN=

# CORS / app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TRUST_PROXY_HEADERS=true
SEED_ON_STARTUP=true
RATE_LIMIT_EXPLAIN=30/minute
SESSION_TTL_HOURS=72
