# Copy to backend/.env (or export in your shell / hosting dashboard).
# Never commit real secrets.

# --- Database ---
# Local default (SQLite) — leave unset or use:
# DATABASE_URL=sqlite:///./pathology_explainer.db
# Production (Neon / Supabase / Railway Postgres):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- LLM (API key stays on the server only) ---
# Default: mock (deterministic, no key). Hosted providers fall back to mock if no key is set.
LLM_PROVIDER=mock
LLM_MODEL=mock-heuristic-v1

# Preferred hosted provider: xAI Grok (OpenAI-compatible API at https://api.x.ai/v1)
# Current default model id supports structured / JSON output (see xAI docs).
# LLM_PROVIDER=xai
# LLM_MODEL=grok-4.7
# LLM_API_KEY=xai-...
# LLM_BASE_URL=https://api.x.ai/v1
# Optional alias (also accepted when LLM_PROVIDER=xai):
# XAI_API_KEY=xai-...

# Alternative: OpenAI or any OpenAI-compatible gateway
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1

# --- App ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true
RATE_LIMIT_EXPLAIN=30/minute
SESSION_TTL_HOURS=72

# --- Frontend (optional; Vite proxy covers local /api) ---
# VITE_API_BASE_URL=https://your-api.example.com
