# Copy to backend/.env (or export in your shell / hosting dashboard).
# Never commit real secrets.

# --- Runtime ---
# APP_ENV=development
# APP_ENV=production

# --- Database ---
# DATABASE_URL=sqlite:///./pathology_explainer.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- LLM (API key stays on the server only) ---
LLM_PROVIDER=mock
LLM_MODEL=mock-heuristic-v1
LLM_TIMEOUT_SECONDS=120

# xAI Grok (preferred hosted provider)
# LLM_PROVIDER=xai
# LLM_MODEL=grok-4.20-0309-non-reasoning
# LLM_API_KEY=xai-...
# LLM_BASE_URL=https://api.x.ai/v1
# XAI_API_KEY=xai-...

# OpenAI / compatible
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1

# --- Demo invite tokens (optional) ---
# Local development seeds known DEMO_* defaults when these are unset.
# In production (APP_ENV=production), demo users are skipped unless you set all three.
# DEMO_ADMIN_TOKEN=
# DEMO_ANNOTATOR_TOKEN=
# DEMO_CLINICIAN_TOKEN=

# --- App ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TRUST_PROXY_HEADERS=true
SEED_ON_STARTUP=true
RATE_LIMIT_EXPLAIN=30/minute
SESSION_TTL_HOURS=72

# --- Frontend (optional; Vite proxy covers local /api) ---
# VITE_API_BASE_URL=https://pathology-report-explainer-api.onrender.com
